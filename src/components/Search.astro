---
import SearchComponent from "astro-pagefind/components/Search";
---

<div class="search-container">
  <button id="search-btn" class="search-trigger-btn" aria-label="Search documentation">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
    <span>Search docs...</span>
    <kbd class="kbd-badge">⌘K</kbd>
  </button>
</div>

<!-- Modal Backdrop -->
<div id="search-backdrop" class="search-backdrop hidden"></div>

<!-- Search Dialog Modal -->
<div id="search-modal" class="search-modal hidden" role="dialog" aria-modal="true">
  <div class="search-modal-content">
    <SearchComponent 
      id="search-box" 
      className="pagefind-ui-search" 
      uiOptions={{ 
        showImages: false, 
        showSubResults: true,
        placeholder: "Search documentation..."
      }} 
    />
  </div>
</div>

<style is:global>
  /* Header Trigger Button */
  .search-trigger-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    font-weight: 500;
    border-radius: var(--radius);
    background-color: var(--secondary);
    color: var(--muted-foreground);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .search-trigger-btn:hover {
    border-color: var(--primary);
    color: var(--foreground);
  }
  .search-icon {
    opacity: 0.7;
  }
  .kbd-badge {
    font-size: 0.7rem;
    padding: 1px 5px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
    margin-left: 0.5rem;
    opacity: 0.8;
  }

  /* Backdrop blur */
  .search-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: oklch(0 0 0 / 40%);
    backdrop-filter: blur(8px);
    z-index: 1000;
  }

  /* Centered Modal Dialog Box */
  .search-modal {
    position: fixed;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 600px;
    background-color: var(--card);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    box-shadow: var(--shadow-elevated);
    z-index: 1001;
    overflow: hidden;
    font-family: var(--font-sans);
  }
  
  .hidden { display: none !important; }

  /* Pagefind UI Variables Override inside Modal */
  .search-modal-content {
    --pagefind-ui-primary: var(--primary);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--card);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--secondary);
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-font: var(--font-sans);
  }

  /* Style Search input inside modal */
  .search-modal-content .pagefind-ui-search .pagefind-ui__form {
    position: relative;
    width: 100%;
    margin: 0;
  }
  .search-modal-content .pagefind-ui-search .pagefind-ui__search-input {
    font-size: 1.05rem !important;
    height: 52px !important;
    padding: 0 1rem 0 3rem !important;
    border: none !important;
    border-bottom: 1px solid var(--border) !important;
    border-radius: calc(var(--radius) * 1.5) calc(var(--radius) * 1.5) 0 0 !important;
    background-color: transparent !important;
    color: var(--foreground) !important;
    font-weight: 500 !important;
  }
  .search-modal-content .pagefind-ui-search .pagefind-ui__search-input:focus {
    outline: none !important;
    background-color: oklch(from var(--secondary) l c h / 10%) !important;
  }

  /* Position Search Icon inside the form */
  .search-modal-content .pagefind-ui-search .pagefind-ui__form::before {
    top: 18px !important;
    left: 1.25rem !important;
    width: 16px !important;
    height: 16px !important;
  }

  /* Search Drawer - sits inside the modal content naturally */
  .search-modal-content .pagefind-ui-search .pagefind-ui__drawer {
    position: static !important;
    max-height: 380px !important;
    overflow-y: auto !important;
    padding: 1.25rem !important;
    margin-top: 0 !important;
  }
  
  .search-modal-content .pagefind-ui-search .pagefind-ui__results-area {
    margin-top: 0 !important;
  }
  
  .search-modal-content .pagefind-ui-search .pagefind-ui__message {
    font-size: 0.8rem !important;
    padding: 0 0 0.5rem 0 !important;
    margin-bottom: 0.75rem !important;
    border-bottom: 1px solid var(--border) !important;
    color: var(--muted-foreground) !important;
  }
  
  .search-modal-content .pagefind-ui-search .pagefind-ui__result {
    padding: 0.75rem 0 !important;
    border-bottom: 1px solid var(--border) !important;
  }
  .search-modal-content .pagefind-ui-search .pagefind-ui__result:last-child {
    border-bottom: none !important;
  }
  .search-modal-content .pagefind-ui-search .pagefind-ui__result-title {
    font-size: 0.95rem !important;
    font-weight: 600 !important;
    font-family: var(--font-heading) !important;
  }
  .search-modal-content .pagefind-ui-search .pagefind-ui__result-link {
    color: var(--primary) !important;
    text-decoration: none !important;
  }
  .search-modal-content .pagefind-ui-search .pagefind-ui__result-excerpt {
    font-size: 0.85rem !important;
    color: var(--muted-foreground) !important;
    line-height: 1.4 !important;
    margin-top: 0.25rem !important;
  }
  
  /* Highlight matching content */
  .search-modal-content .pagefind-ui-search mark {
    background-color: oklch(from var(--brand-yellow) l c h / 30%) !important;
    color: var(--foreground) !important;
    font-weight: 600 !important;
    padding: 0 2px !important;
    border-radius: 2px !important;
  }

  @media (max-width: 768px) {
    .search-modal {
      top: 10%;
      width: 95%;
    }
  }
</style>

<script>
  const btn = document.getElementById('search-btn');
  const backdrop = document.getElementById('search-backdrop');
  const modal = document.getElementById('search-modal');
  
  function openSearch() {
    backdrop?.classList.remove('hidden');
    modal?.classList.remove('hidden');
    
    // Auto-focus input when modal opens
    setTimeout(() => {
      const input = modal?.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
      input?.focus();
      input?.select();
    }, 50);
    
    document.body.style.overflow = 'hidden';
  }
  
  function closeSearch() {
    backdrop?.classList.add('hidden');
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
  }
  
  btn?.addEventListener('click', openSearch);
  backdrop?.addEventListener('click', closeSearch);
  
  // Listen for global keyboard shortcuts
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === '/') {
      const active = document.activeElement;
      if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return;
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') {
      closeSearch();
    }
  });
</script>
