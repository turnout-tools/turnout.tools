---
import CocPreview from "./CocPreview.astro";
import rawTemplate from "./template.md?raw";
---

<div class="coc-generator-layout" data-template={rawTemplate}>
    <div class="coc-instructions-card">
        <div class="instruction-icon">💡</div>
        <div class="instruction-content">
            <strong>How to use this template:</strong>
            <p>
                Use the tabs below to preview the document or view the raw
                Markdown code. When copying the template, remember to replace
                the placeholders—like <code>{`{{org-name}}`}</code>, <code
                    >{`{{short-name}}`}</code
                >, and <code>{`{{email}}`}</code>—with your community's actual
                details.
            </p>
        </div>
    </div>

    <div class="coc-column-preview">
        <div class="coc-toolbar">
            <div class="tab-buttons">
                <button
                    id="btn-tab-preview"
                    class="tab-btn active"
                    type="button"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="tab-icon"
                        ><circle cx="12" cy="12" r="10"></circle><circle
                            cx="12"
                            cy="12"
                            r="3"></circle></svg
                    >
                    Rich Text
                </button>
                <button id="btn-tab-markdown" class="tab-btn" type="button">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="tab-icon"
                        ><path
                            d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
                        ></path><polyline points="14 2 14 8 20 8"
                        ></polyline><line x1="16" y1="13" x2="8" y2="13"
                        ></line><line x1="16" y1="17" x2="8" y2="17"
                        ></line><line x1="10" y1="9" x2="8" y2="9"></line></svg
                    >
                    Plain Text
                </button>
            </div>

            <button
                id="btn-copy-clipboard"
                class="btn btn-secondary btn-copy"
                type="button"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="copy-icon"
                    ><rect width="14" height="14" x="8" y="8" rx="2" ry="2"
                    ></rect><path
                        d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                    ></path></svg
                >
                <span id="copy-btn-text">Copy to Clipboard</span>
            </button>
        </div>

        <!-- Active Content Area -->
        <div class="coc-content-card">
            <div id="panel-preview" class="tab-panel active">
                <CocPreview />
            </div>
            <div id="panel-markdown" class="tab-panel">
                <pre
                    class="markdown-code-block"><code id="coc-markdown-textarea">{rawTemplate}</code></pre>
            </div>
        </div>
    </div>
</div>

<!-- Custom Toast Notification -->
<div id="coc-toast" class="coc-toast hidden">
    <span id="coc-toast-message">Copied to clipboard!</span>
</div>

<style>
    .coc-generator-layout {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin-top: 1.5rem;
    }

    .coc-instructions-card {
        background-color: var(--secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        margin-bottom: 2rem;
    }

    .instruction-icon {
        font-size: 1.25rem;
        line-height: 1.4;
    }

    .instruction-content {
        font-size: 0.9rem;
        color: var(--muted-foreground);
        line-height: 1.5;
    }

    .instruction-content strong {
        color: var(--foreground);
        display: block;
        margin-bottom: 0.25rem;
    }

    .instruction-content p {
        margin: 0;
    }

    .instruction-content code {
        background-color: var(--card);
        border: 1px solid var(--border);
        padding: 0.1rem 0.3rem;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.85em;
    }

    .coc-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .tab-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.9rem;
        font-size: 0.85rem;
        font-family: var(--font-sans);
        font-weight: 600;
        color: var(--muted-foreground);
        background: transparent;
        border: 1px solid transparent;
        border-radius: var(--radius);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .tab-btn:hover {
        color: var(--foreground);
        background-color: var(--secondary);
    }

    .tab-btn.active {
        color: var(--foreground);
        background-color: var(--secondary);
        border-color: var(--border);
    }

    .tab-icon {
        opacity: 0.8;
    }

    .btn-copy {
        font-size: 0.85rem;
        padding: 0.5rem 0.9rem;
        box-shadow: none;
        gap: 0.4rem;
    }

    .coc-content-card {
        background-color: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.5rem;
        box-shadow: var(--shadow-soft);
        min-height: 500px;
    }

    .markdown-code-block {
        margin: 0;
        padding: 1rem;
        background-color: var(--secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow-x: auto;
        font-family: monospace;
        font-size: 0.9rem;
        white-space: pre-wrap;
        word-break: break-all;
        color: var(--foreground);
    }

    @media (max-width: 600px) {
        .coc-content-card {
            padding: 1.5rem;
        }
    }

    .tab-panel {
        display: none;
    }

    .tab-panel.active {
        display: block;
        animation: fadeIn 0.3s ease-out forwards;
    }

    /* Toast Notification */
    .coc-toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        background-color: var(--foreground);
        color: var(--background);
        padding: 0.75rem 1.5rem;
        border-radius: var(--radius);
        box-shadow: var(--shadow-elevated);
        z-index: 1000;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        transform: translateY(0);
        opacity: 1;
    }

    .coc-toast.hidden {
        display: none;
        opacity: 0;
        transform: translateY(20px);
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    // DOM Elements - Tabs and Panels
    const btnTabPreview = document.getElementById("btn-tab-preview");
    const btnTabMarkdown = document.getElementById("btn-tab-markdown");
    const panelPreview = document.getElementById("panel-preview");
    const panelMarkdown = document.getElementById("panel-markdown");

    // DOM Elements - Copy and Markdown
    const btnCopyClipboard = document.getElementById("btn-copy-clipboard");
    const copyBtnText = document.getElementById("copy-btn-text");
    const markdownCodeEl = document.getElementById("coc-markdown-textarea");

    // DOM Elements - Toast
    const cocToast = document.getElementById("coc-toast");
    const cocToastMessage = document.getElementById("coc-toast-message");

    // Retrieve raw template
    const generatorLayout = document.querySelector(
        ".coc-generator-layout",
    ) as HTMLElement;
    const rawTemplate = generatorLayout?.dataset.template || "";

    // State
    let activeTab: "preview" | "markdown" = "preview";

    // Highlight placeholders in preview tab
    const previewEl = document.getElementById("coc-preview-content");
    if (previewEl) {
        previewEl.innerHTML = previewEl.innerHTML.replace(
            /\{\{([a-zA-Z0-9_-]+)\}\}/g,
            '<span class="variable-token highlight">{{$1}}</span>',
        );
    }

    // Tab switching logic
    if (btnTabPreview && btnTabMarkdown && panelPreview && panelMarkdown) {
        btnTabPreview.addEventListener("click", () => {
            activeTab = "preview";
            btnTabPreview.classList.add("active");
            btnTabMarkdown.classList.remove("active");
            panelPreview.classList.add("active");
            panelMarkdown.classList.remove("active");
        });

        btnTabMarkdown.addEventListener("click", () => {
            activeTab = "markdown";
            btnTabMarkdown.classList.add("active");
            btnTabPreview.classList.remove("active");
            panelMarkdown.classList.add("active");
            panelPreview.classList.remove("active");
        });
    }

    // Toast Functionality
    function showToast(message: string) {
        if (cocToast && cocToastMessage) {
            cocToastMessage.textContent = message;
            cocToast.classList.remove("hidden");
            setTimeout(() => {
                cocToast.classList.add("hidden");
            }, 2500);
        }
    }

    // Copy to Clipboard logic
    if (btnCopyClipboard && copyBtnText) {
        btnCopyClipboard.addEventListener("click", () => {
            let contentToCopy = "";
            if (activeTab === "markdown") {
                contentToCopy = rawTemplate;
            } else {
                const previewEl = document.getElementById(
                    "coc-preview-content",
                );
                if (previewEl) {
                    contentToCopy = previewEl.innerText;
                } else {
                    contentToCopy = rawTemplate;
                }
            }

            navigator.clipboard
                .writeText(contentToCopy)
                .then(() => {
                    showToast(
                        activeTab === "markdown"
                            ? "Markdown template copied!"
                            : "Document text copied!",
                    );
                    const oldText = copyBtnText.textContent;
                    copyBtnText.textContent = "Copied!";
                    btnCopyClipboard.classList.add("btn-primary");
                    btnCopyClipboard.classList.remove("btn-secondary");
                    setTimeout(() => {
                        copyBtnText.textContent = oldText;
                        btnCopyClipboard.classList.remove("btn-primary");
                        btnCopyClipboard.classList.add("btn-secondary");
                    }, 1500);
                })
                .catch((err) => {
                    console.error("Failed to copy: ", err);
                    showToast("Failed to copy to clipboard.");
                });
        });
    }
</script>
