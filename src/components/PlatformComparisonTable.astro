        transform: rotate(0deg);
    }

    /* Cell Value Custom Classes */
    .cell-value {
        text-align: center;
        font-weight: 500;
    }

    .cell-content {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        width: 100%;
    }

    .value-text {
        font-size: 0.9rem;
    }

    .positive {
        color: #10b981;
        background: rgba(16, 185, 129, 0.06);
    }

    .negative {
        color: #ef4444;
        background: rgba(239, 68, 68, 0.06);
    }

    .warning {
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.06);
    }

    .neutral {
        color: var(--foreground);
        opacity: 0.85;
    }

    .tooltip-container {
        position: relative;
        display: inline-flex;
        cursor: help;
    }

    .info-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--muted);
        color: var(--muted-foreground);
        font-size: 0.65rem;
        font-weight: 700;
        transition: all 0.2s ease;
    }

