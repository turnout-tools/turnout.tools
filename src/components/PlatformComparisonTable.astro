        visibility: hidden;
        position: absolute;
        bottom: 125%;
        left: 50%;
        transform: translateX(-50%);
        background: #0f0f15;
        color: #ffffff;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        width: 220px;
        font-size: 0.75rem;
        line-height: 1.4;
        text-align: left;
        box-shadow:
            0 10px 15px -3px rgba(0, 0, 0, 0.3),
            0 4px 6px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid var(--border);
        z-index: 50;
        opacity: 0;
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
        pointer-events: none;
    }

