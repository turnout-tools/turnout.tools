---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Hero Section -->
  <section class="hero-section" style="position: relative; overflow: hidden; padding: 10rem 0 10rem; display: flex; align-items: center; justify-content: center; min-height: calc(100vh - var(--header-height) - 100px);">
    <div class="mesh-bg"></div>
    <div class="container" style="position: relative; z-index: 10; text-align: center;">
      <h1 class="hero-title" style="font-size: 2.75rem; line-height: 1.3; margin: 0 auto; max-width: 800px; font-weight: 500; font-family: var(--font-heading); color: var(--foreground); letter-spacing: -0.02em;">
        your <span style="font-family: var(--font-sans); font-style: italic; font-weight: 300; color: var(--brand-orange); font-size: 0.85em;">(small)</span> team's toolbox for running <span style="font-family: var(--font-sans); font-style: italic; font-weight: 300; color: var(--brand-orange); font-size: 0.85em;">(big)</span> communities and events
      </h1>
    </div>
  </section>
</Layout>

<style>
  .hero-title {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
